# OpenAI-compatible external LLM endpoint.
# Examples:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:8000/v1
LLM_BASE_URL=

# Provider API key. Keep the real .env file uncommitted.
LLM_API_KEY=

# Optional. Override the model slug used by the pipeline.
# Example for OpenRouter:
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
LLM_MODEL=qwen/qwen-2.5-7b-instruct
